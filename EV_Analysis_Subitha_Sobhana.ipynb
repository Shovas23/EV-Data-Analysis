    "\n",
    "col_name = \"cafv_status\"\n",
    "ev[\"cafv_status\"] = ev[\"cafv_status\"].astype(\"string\") # datatype changed\n",
    "\n",
    "# Filter out rows containing the 'unknown' string\n",
    "filtered_df = ev[\n",
    "    ~ev[col_name].str.contains(\"unknown\", case=False, na=False)\n",
    "]\n",
    "#ev[\"cafv_status\"].value_counts().reset_index()\n",
    "# Get counts for the remaining valid categories\n",
    "cafv_counts = filtered_df[col_name].value_counts()\n",
    "\n",
    "# Plot the cleaned pie chart\n",
    "plt.figure(figsize=(6, 4))\n",
