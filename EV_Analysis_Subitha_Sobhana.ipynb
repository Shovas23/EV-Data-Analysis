   "source": [
    "#VINs anonymization using Hashlib-Sample\n",
    "import hashlib\n",
    "\n",
    "salt = \"my_super_secret_random_salt_string\"\n",
    "\n",
    "def anonymize_vin(vin, salt):\n",
    "    # Combine salt and VIN to prevent rainbow table attacks\n",
    "    raw_str = salt + str(vin)\n",
    "    # Generate SHA-256 hash and return hex string\n",
    "    return hashlib.sha256(raw_str.encode('utf-8')).hexdigest()\n",
    "\n",
    "# Test uniqueness mapping\n",
    "original_vin = \"5UX43EU07S\"\n",
    "anon_vin = anonymize_vin(original_vin, salt)\n",
    "print(\"Anonymize VIN Number : \",anon_vin)"
   ]
  },
