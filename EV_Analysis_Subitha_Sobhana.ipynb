   "source": [
    "# 1. Convert ALL zeros to NaN so pandas can track them properly\n",
    "ev['Base MSRP'] = ev['Base MSRP'].replace(0, np.nan)\n",
    "# 2. Tier 1: Fill using the median of that specific Make\n",
    "ev['Base MSRP'] = ev.groupby('Make')['Base MSRP'].transform(lambda x: x.fillna(x.median()))\n",
    "# Fill any leftover NaNs (the 200 rows) with the overall dataset median\n",
    "overall_median = ev['Base MSRP'].median()\n",
    "ev['Base MSRP'] = ev['Base MSRP'].fillna(overall_median)\n",
    "# 3. Convert back to integer if needed\n",
    "ev['Base MSRP'] = ev['Base MSRP'].astype(float)\n",
    "print(\"Remaining missing values:\", (ev['Base MSRP'] == 0).sum())"
